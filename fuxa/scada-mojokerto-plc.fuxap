    "svgcontent": "<svg width=\"1400\" height=\"820\" xmlns=\"http://www.w3.org/2000/svg\"><rect x=\"0\" y=\"0\" width=\"1400\" height=\"820\" fill=\"#f4f6f8\" stroke-width=\"0\" id=\"bg\"/><text x=\"40\" y=\"44\" font-family=\"sans-serif\" font-size=\"26\" fill=\"#263238\" text-anchor=\"start\" font-weight=\"bold\" stroke-width=\"0\">SCADA Mojokerto - 5 VSD + Flow</text><text x=\"40\" y=\"72\" font-family=\"sans-serif\" font-size=\"14\" fill=\"#546e7a\" text-anchor=\"start\" font-weight=\"normal\" stroke-width=\"0\">PLC M221</text><g id=\"LMP_plc_conn\" type=\"svg-ext-gauge_semaphore\" font-family=\"sans-serif\" font-size=\"14\"><ellipse cx=\"120\" cy=\"67\" rx=\"9\" ry=\"9\" fill=\"#c62828\" stroke=\"#607d8b\" stroke-width=\"1\" id=\"LMP_plc_conn_e\"/></g><text x=\"150\" y=\"72\" font-family=\"sans-serif\" font-size=\"14\" fill=\"#546e7a\" text-anchor=\"start\" font-weight=\"normal\" stroke-width=\"0\">Mode panel</text><g id=\"LMP_mode\" type=\"svg-ext-gauge_semaphore\" font-family=\"sans-serif\" font-size=\"14\"><ellipse cx=\"245\" cy=\"67\" rx=\"9\" ry=\"9\" fill=\"#bdbdbd\" stroke=\"#607d8b\" stroke-width=\"1\" id=\"LMP_mode_e\"/></g><text x=\"265\" y=\"72\" font-family=\"sans-serif\" font-size=\"12\" fill=\"#90a4ae\" text-anchor=\"start\" font-weight=\"normal\" stroke-width=\"0\">hijau = REMOTE (SCADA), kuning = LOCAL (tombol panel; START/STOP di sini diabaikan PLC)</text><text x=\"900\" y=\"72\" font-family=\"sans-serif\" font-size=\"14\" fill=\"#546e7a\" text-anchor=\"start\" font-weight=\"normal\" stroke-width=\"0\">E-stop</text><g id=\"LMP_estop\" type=\"svg-ext-gauge_semaphore\" font-family=\"sans-serif\" font-size=\"14\"><ellipse cx=\"960\" cy=\"67\" rx=\"9\" ry=\"9\" fill=\"#c62828\" stroke=\"#607d8b\" stroke-width=\"1\" id=\"LMP_estop_e\"/></g><rect x=\"40\" y=\"95\" width=\"440\" height=\"350\" rx=\"8\" fill=\"#ffffff\" stroke=\"#cfd8dc\" stroke-width=\"1\" id=\"panel_vsd1\"/><text x=\"58\" y=\"127\" font-family=\"sans-serif\" font-size=\"22\" fill=\"